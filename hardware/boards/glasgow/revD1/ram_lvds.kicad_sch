	(text "Note for revD0 users:\nD0 used the header instead of the receptacle\nfootprint by mistake which made it necessary to flip\nJ6 along the X-axis. The pinout remains the same for\naddons in practice."
		(exclude_from_sim no)
		(at 245.11 67.31 0)
		(effects
			(font
				(size 0.635 0.635)
				(color 204 102 0 1)
			)
			(justify left)
		)
		(uuid "71433a12-6ba2-4467-8bbc-2ac1083c804b")
	)
	(text "USB is reverse-current protected, addons needing more than ~2.5W\nshould provide their own power, back-powering the board is allowed.\nCurrent draw limited to 0.3A/pin for a total of 1.5A for 5V."
		(exclude_from_sim no)
		(at 208.28 29.21 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "92825976-4471-48e8-b57f-d874af641634")
	)
	(text "The LVDS connector J5 just \nhas minimal ESD protection.\nUse appropriate ESD handling\nprocedures. Plug and unplug \nonly in completely unpowered \nstate.\n"
		(exclude_from_sim no)
		(at 245.11 96.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "998e0525-22f0-4270-8dfa-bedfb0c320e6")
	)
	(text "Suggested mating connector:\nHirose DF12NC-60DS-0.5V(51)\n\nCompatible connectors:\nHC-PBB12NB(5.0)-60DP-0.5V-03\nHC-PBB12NB(5.0)-60DP-0.5V-P-03"
