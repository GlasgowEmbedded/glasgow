msgid "Expose SPI via a socket using the flashrom serprog protocol; see https://flashrom.org."
msgstr ""

#: ../../<autoprogram>:1
msgid "This applet has the same default pin assignment as the `memory-25x` applet; see its description for details."
msgstr ""

