#: ../../src/applets/interface/analyzer2.rst:10
msgid "CLI reference"
msgstr ""

#: ../../<autoprogram>:1
msgid "glasgow run analyzer2"
msgstr ""

#: ../../<autoprogram>:1
msgid "Capture values of digital inputs as a time series sequence."
msgstr ""

#: ../../<autoprogram>:1
msgid "At the moment, this applet is designed primarily for use with external tools or in script/REPL mode. When ran normally, it listens on a TCP port and exposes an open protocol that frontend applications like Sigrok can use."
msgstr ""

#: ../../<autoprogram>:1
msgid "First, configure the probes and voltage level:"
msgstr ""

#: ../../<autoprogram>:1
msgid "glasgow run analyzer2 -V A=3.3 CMD=A0 CLK=A1 DAT=A2:5"
msgstr ""

#: ../../<autoprogram>:1
msgid "Then, run Sigrok:"
msgstr ""

#: ../../<autoprogram>:1
msgid "sigrok-cli -d glasgow:conn=tcp-raw/127.0.0.1/5555 -c samplerate=12m --samples 10000"
msgstr ""

#: ../../<autoprogram>:1
msgid "Or, run PulseView (you can also configure the connection in the GUI):"
msgstr ""

#: ../../<autoprogram>:1
msgid "pulseview -d glasgow:conn=tcp-raw/127.0.0.1/5555"
msgstr ""

#: ../../<autoprogram>:1
msgid "usage: glasgow run analyzer2 [-h] [-V SPEC] [--buffer-size SIZE] [--listen [ENDPOINT]] PROBES [PROBES ...]"
msgstr ""

#: ../../<autoprogram>:1
msgid "probe I/O lines PROBES, optionally naming them (e.g.: A0, A0:1, DATA=B0)"
msgstr ""

#: ../../<autoprogram>:1
msgid "show this help message and exit"
msgstr ""

#: ../../<autoprogram>:1
msgid "configure I/O port voltage to SPEC (e.g.: '3.3', 'A=5.0,B=3.3', 'A=SA')"
msgstr ""

#: ../../<autoprogram>:1
msgid "use SIZE bytes for capture buffer (e.g. 0x100000 for 1 MB)"
msgstr ""

#: ../../<autoprogram>:1
msgid "listen at ENDPOINT, either unix:PATH or tcp:HOST:PORT (default: tcp:localhost:5555)"
msgstr ""

